<% content_for(:title) { "Reviewers Dashboard" } %>

<%= tag.div class: "container-fluid m-0 p-0", data: { controller: "heartbeat" } do %>
  <%= link_to "Skip to main content", "#main-content", class: "skip-link" %>

  <%= tag.nav class: %w[navbar dashboard-navbar navbar-expand-md px-3], aria: { label: "Dashboard" } do %>
    <% unless Rails.env.production? %>
      <span class="environment-label">Dev</span>
    <% end %>
    <% links = Rails.application.config_for(:reviewers)&.dig(:dashboard, :links) %>
    <%= render "shared/links_button", links: links %>

    <div
      class="navbar-brand dashboard-brand d-flex align-items-center me-auto"
      data-controller="bootstrap-tooltip">
      <%= tag.div class: "mb-0 ms-2 d-flex align-items-center" do %>
        <h1 class="dashboard-heading">Reviewers</h1>
        <span class="collapse navbar-collapse">
          &nbsp;for&nbsp;
          <%= params[:group_path] %>
        </span>
      <% end %>
    </div>

    <%= render "shared/navbar_right_section" %>
  <% end %>

  <%= tag.main(id: "main-content", class: %w[dashboard-content]) do %>
    <%= tag.div(id: "reviewers", class: %w[table-responsive dashboard-panel align-middle]) do %>
      <%= turbo_frame_tag :reviewers, GroupReviewersDto.name.underscore, params[:group_path], src: reviewers_list_path(reviewers_controller_params) do %>
        <%= tag.div(class: "d-flex align-items-center justify-content-center p-3 w-100 h-100") do %>
          <span
            class="spinner-border me-3 d-none d-sm-inline"
            role="status"
            aria-hidden="true"></span>
          <span>Loading reviewers…</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
