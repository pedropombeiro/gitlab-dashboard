<% content_for(:title) { "GitLab MR Dashboard" } %>

<% vapid_public_key =
  Rails.application.credentials.dig(:webpush, :vapid_public_key) %>
<% if vapid_public_key.present? %>
  <%= tag.meta name: "web_push_public_key",
           content: Base64.urlsafe_decode64(vapid_public_key).bytes.to_s %>
<% end %>

<%# Subscribe to real-time Turbo Stream updates for this user %>
<%= turbo_stream_from merge_request_stream_name(@user, :open) %>
<%= turbo_stream_from merge_request_stream_name(@user, :merged) %>

<%= tag.div class: "container-fluid m-0 p-0", data: {
    controller: "web-push heartbeat",
    web_push_unsubscribed_class: "d-initial",
    web_push_subscribed_class: "d-none"
  } do %>
  <%= link_to "Skip to main content", "#main-content", class: "skip-link" %>

  <%= tag.nav class: %w[navbar dashboard-navbar navbar-expand-sm px-3], aria: { label: "Dashboard" } do %>
    <% unless Rails.env.production? %>
      <span class="environment-label">Dev</span>
    <% end %>
    <% if params.include?(:referrer) %>
      <%= link_to(safe_url(params[:referrer]), class: %w[btn mx-2], aria: { label: "Back to dashboard" }) do %>
        <%= tag.i class: %w[fa-solid fa-home] %>
      <% end %>
    <% end %>

    <% links = Rails.application.config.merge_requests&.dig(:dashboard, :links) %>
    <%= render "shared/links_button", links: links %>

    <div
      class="navbar-brand dashboard-brand d-flex align-items-center me-auto"
      data-controller="bootstrap-tooltip">
      <%= tag.div class: "mb-0 ms-2 text-body d-flex align-items-center" do %>
        <span class="d-sm-none me-2">
          <%= render "shared/user_image", user: @user, size: 24 %>
        </span>
        <h1 class="dashboard-heading">Merge requests</h1>
        <span class="d-none d-md-flex align-items-center dashboard-user">
          <% user_presenter = UserPresenter.new(@user, self) %>
          <%= render "shared/user_badge", user: @user, user_presenter: user_presenter, content: user_presenter.help_content, size: 24 %>
        </span>
      <% end %>

      <%= tag.button(
        class: %w[btn mx-2],
        aria: { label: "Subscribe to merge request notifications" },
        data: {
          bs_toggle: "tooltip",
          bs_title: "Subscribe to web push notifications for MR events, such as MR merged, or workflow label changes",
          web_push_target: "subscribe",
          action: "web-push#subscribe"
        },
      ) do %>
        <%= tag.i class: %w[fa-solid fa-bell] %>
      <% end %>
    </div>

    <%= render "shared/navbar_right_section" %>
  <% end %>

  <%= tag.main(id: "main-content", class: %w[dashboard-content]) do %>
    <%= tag.section(id: "open_merge_requests", class: mr_list_panel_classes, aria: { label: "Open merge requests" }, data: { controller: "mr-list" }) do %>
      <%= turbo_frame_tag @dto, :open_merge_requests, src: open_merge_requests_list_path(merge_requests_controller_params) do %>
        <% if @dto.has_content? %>
          <!-- Show last stored state, while we wait for the refreshed state
          -->
          <%= render "open_merge_requests",
          merge_requests_dto: @dto.open_merge_requests,
          updated_at: @dto.updated_at,
          next_update_at: @dto.next_update_at,
          request_duration: @dto.request_duration %>
        <% else %>
          <%= tag.div(class: "d-flex align-items-center justify-content-center p-3 w-100 h-100") do %>
            <span
              class="spinner-border me-3 d-none d-sm-inline"
              role="status"
              aria-hidden="true"></span>
            <span>Loading open merge requests…</span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= tag.section(id: "merged_merge_requests", class: mr_list_panel_classes + %w[merged-panel], aria: { label: "Recently merged" }, data: { controller: "turbo-frame-focus" }) do %>
      <div class="panel-heading"><h2>Recently merged</h2><span class="text-secondary small">Past week</span></div>
      <%= turbo_frame_tag(@dto, :merged_merge_requests, loading: "lazy", src: merged_merge_requests_list_path(merge_requests_controller_params), data: { turbo_frame_focus_target: "frame" }) do %>
        <%= tag.div(class: "d-flex align-items-center justify-content-center p-3 w-100 h-100") do %>
          <span
            class="spinner-border me-3 d-none d-sm-inline"
            role="status"
            aria-hidden="true"></span>
          <span>Loading merged merge requests…</span>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
