<% merge_requests = merge_requests_dto.items %>

<%= render "merge_requests/open_mrs_summary",
  merge_requests: merge_requests,
  mr_age_limit: mr_age_limit,
  mttm_handbook_url: mttm_handbook_url,
  request_duration: request_duration,
  updated_at: updated_at,
  next_update_at: next_update_at %>

<% if merge_requests.empty? %>
  <div class="dashboard-empty">
    <i class="bi bi-check2-circle" aria-hidden="true"></i>
    <h3>No open merge requests</h3>
    <p>Your open merge requests will appear here.</p>
  </div>
<% else %>
  <table class="table table-hover mr-table mb-0">
    <caption class="visually-hidden">Open merge requests, most recently updated first</caption>
    <%= render "merge_requests/open_mrs_table_header" %>
    <tbody>
      <% merge_requests.each do |mr| %>
        <% mr_presenter = MergeRequestPresenter.new(mr) %>
        <% row_id = "mr_#{mr.project.fullPath.parameterize}_#{mr.iid}" %>
        <%= tag.tr id: row_id, data: {
          mr_list_target: "row", failed: failed_pipeline?(mr), review: !mr.approved && mr.approvalsLeft.positive?,
          search: strip_tags("#{mr.titleHtml} #{mr.project.fullPath} #{mr.reference}").downcase
        } do %>
          <th scope="row" class="mr-identity">
            <%= link_to mr.titleHtml.html_safe, mr.webUrl, target: "_blank", rel: "noopener", class: "mr-title", id: "#{row_id}_title" %>
            <div class="mr-metadata">
              <span class="mr-project"><%= mr.project.fullPath %></span>
              <%= render "mr_relation", merge_request: mr %>
            </div>
            <details id="<%= row_id %>_details" class="mr-details" data-action="toggle->mr-list#rememberDetails">
              <summary id="<%= row_id %>_summary">Details</summary>
              <%= render "open_mr_details", mr: mr, mr_presenter: mr_presenter %>
            </details>
          </th>
          <td data-label="Status" class="mr-status-cell">
            <%= render "label", title: mr.mergeStatusLabel, class: [ "bg-#{mr.bootstrapClass[:mergeStatus]}" ] %>
            <% if mr.blocked && mr.mergeStatusLabel != "Blocked" %><span class="status-note"><i class="bi bi-lock" aria-hidden="true"></i> Blocked</span><% end %>
            <% if mr.conflicts %><span class="status-note text-danger-emphasis"><i class="bi bi-exclamation-diamond" aria-hidden="true"></i> Conflicts</span><% end %>
            <% open_blockers = mr.blockingMergeRequests.visibleMergeRequests.select { |blocker| blocker.state == "opened" } %>
            <% if open_blockers.any? %>
              <%= tag.span class: "status-note", title: "Blocked by #{open_blockers.map { |blocker| "!#{blocker.iid}" }.join(", ")}" do %>
                <i class="bi bi-sign-stop" aria-hidden="true"></i> <%= pluralize(open_blockers.count, "blocker") %>
              <% end %>
            <% end %>
          </td>
          <td data-label="Pipeline" class="mr-pipeline-cell">
            <%= render "open_mr_pipeline", mr: mr %>
          </td>
          <td data-label="Review" class="mr-review-cell">
            <div class="approval-progress">
              <% if mr.approved %>
                <span class="text-success-emphasis"><i class="bi bi-check2" aria-hidden="true"></i> Approved</span>
              <% elsif mr.approvalsRequired.zero? %>
                <span class="text-secondary">No approvals required</span>
              <% else %>
                <%= tag.span "#{mr.approvalsRequired - mr.approvalsLeft} / #{mr.approvalsRequired} approved", data: {
                  bs_toggle: "tooltip", bs_html: "true", bs_custom_class: "x-wide-tooltip", bs_title: mr_presenter.approvals_tooltip
                } %>
              <% end %>
            </div>
            <div class="mr-reviewers">
              <%= render(partial: "reviewer_badge", collection: mr.reviewers.nodes.sort_by { |r| r.mergeRequestInteraction.reviewState }.reverse, as: :reviewer) || tag.span("No reviewers", class: "text-secondary small") %>
            </div>
          </td>
          <td data-label="Activity" class="mr-activity-cell">
            <div><%= render "shared/relative_timestamp", timestamp: mr.updatedAt, most_significant_only: true %></div>
            <div class="mr-created text-secondary">Opened <%= render "shared/relative_timestamp", timestamp: mr.createdAt, age_warning: true, most_significant_only: true %></div>
          </td>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <p class="dashboard-empty mb-0" data-mr-list-target="empty" hidden>No merge requests match these filters.</p>
<% end %>
