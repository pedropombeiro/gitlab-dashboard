<div class="panel-heading">
  <h2>Open merge requests <span class="section-count"><%= merge_requests.count %></span></h2>
  <%= render "shared/request_info",
    request_duration: request_duration,
    updated_at: updated_at,
    next_update_at: next_update_at %>
</div>

<span class="visually-hidden" role="status" data-mr-list-target="result"></span>

<div class="mr-toolbar">
  <div class="mr-filters" role="group" aria-label="Filter merge requests">
    <% filters = [
      [ "all", "All open", merge_requests.count ],
      [ "failed", "Failed pipelines", merge_requests.count { |mr| failed_pipeline?(mr) } ],
      [ "review", "Awaiting approval", merge_requests.count { |mr| !mr.approved && mr.approvalsLeft.positive? } ]
    ] %>
    <% filters.each do |value, label, count| %>
      <%= tag.button type: "button", id: "mr-filter-#{value}", class: "mr-filter", aria: { pressed: value == "all" }, data: {
        mr_list_target: "filter", filter: value, action: "mr-list#filter"
      } do %>
        <%= label %> <span class="filter-count"><%= count %></span>
      <% end %>
    <% end %>
  </div>
  <div class="mr-search">
    <i class="bi bi-search" aria-hidden="true"></i>
    <label for="mr-search" class="visually-hidden">Search open merge requests</label>
    <input id="mr-search" type="search" placeholder="Search merge requests…" autocomplete="off"
      data-mr-list-target="search" data-action="input->mr-list#search">
  </div>
</div>

<% if merge_requests.any? %>
  <% avg_open_time = ActiveSupport::Duration.build(merge_requests.sum { |mr| Time.current - mr.createdAt } / merge_requests.count) %>
  <div class="mr-age-summary text-secondary small">
    Average open age:
    <%= tag.span class: avg_open_time > mr_age_limit ? "text-warning-emphasis" : nil do %>
      <%= distance_of_time_in_words(avg_open_time) %>
    <% end %>
    <%= render "merge_requests/info_symbol", data: {
      bs_toggle: "popover", bs_html: "true", bs_title: "Average open age",
      bs_content: "Recommended age: #{distance_of_time_in_words(mr_age_limit)}.<br/>See #{mttm_handbook_url}."
    } %>
  </div>
<% end %>
