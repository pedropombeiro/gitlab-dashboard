#!/usr/bin/env bash
#MISE description="Tail a Rails log file"
#USAGE arg "[env]" help="Rails environment (default: development)" default="development"
#USAGE complete "env" run="find config/environments -name '*.rb' -type f | sed 's|.*/||; s|[.]rb$||'"

set -euo pipefail

tail -f "log/${usage_env:-development}.log"
