#!/usr/bin/env ruby
# frozen_string_literal: true

# Load secrets from files, then run the given command.
#
# For every environment variable named NAME_FILE, read the file it points to and
# export its contents as NAME, with trailing newlines stripped. NAME_FILE is then
# unset. This is the same convention as the official Postgres image, and it works
# with Docker Compose secrets mounted under /run/secrets.
#
# It fails if both NAME and NAME_FILE are set, even to empty strings, or if
# NAME_FILE can't be read. Errors name variables and paths, never values.
#
# This is plain Ruby without Bundler, so that local variables can never collide
# with environment variable names, as shell variables would.
#
# Usage: bin/with-file-env COMMAND [ARGS...]

def fail_with(message, status: 1)
  warn "with-file-env: #{message}"
  exit status
end

file_vars = ENV.keys.grep(/\A[A-Za-z_][A-Za-z0-9_]*_FILE\z/).sort

conflicts = file_vars.map { |file_var| file_var.delete_suffix("_FILE") }.select { |var| ENV.key?(var) }
fail_with "both #{conflicts.first} and #{conflicts.first}_FILE are set; set only one" if conflicts.any?

loaded = file_vars.to_h do |file_var|
  path = ENV.fetch(file_var)
  value =
    begin
      File.binread(path)
    rescue SystemCallError, IOError
      fail_with "#{file_var}: cannot read '#{path}'"
    end

  value = value.sub(/\n+\z/, "")
  fail_with "#{file_var}: '#{path}' contains a NUL byte" if value.include?("\0")

  [file_var, value]
end

loaded.each do |file_var, value|
  ENV[file_var.delete_suffix("_FILE")] = value
  ENV.delete(file_var)
end

fail_with "usage: with-file-env COMMAND [ARGS...]" if ARGV.empty?

begin
  # The [command, argv0] form never goes through a shell, even with one argument.
  exec([ARGV.first, ARGV.first], *ARGV.drop(1))
rescue SystemCallError => e
  fail_with "cannot run '#{ARGV.first}': #{e.message.sub(/ - .*\z/, "")}", status: 127
end
